# Chemora Web — client configuration
# Copy this file to `.env` (in apps/web) and fill in values.
# Frontend environment variables are public; they are NOT secrets.
# Never put backend session secrets, database passwords, or provider secret
# keys here.

# Chemora FastAPI backend base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Public Google OAuth client id.
# Obtain it from the Google Cloud Console → APIs & Services → Credentials,
# and add your frontend origin to the client's "Authorized JavaScript
# origins" (e.g. http://localhost:5173 in development).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com