# ═══════════════════════════════════════════════════════════════════════
# Chemora Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME=Chemora
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://chemora:password@localhost:5432/chemora
DATABASE_URL_SYNC=postgresql://chemora:password@localhost:5432/chemora

# --- Google Authentication ---
# Get from Google Cloud Console → APIs & Services → Credentials
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_ISSUERS=["https://accounts.google.com","accounts.google.com"]

# --- Session Configuration ---
# SESSION_SECRET is auto-generated if empty. Set a stable value for
# multi-instance deployments.
SESSION_SECRET=
SESSION_DURATION_MINUTES=10080
SESSION_INACTIVITY_TIMEOUT_MINUTES=43200
SESSION_RENEWAL_WINDOW_MINUTES=1440

# --- Cookie Configuration ---
# Set COOKIE_SECURE=true in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_NAME=chemora_session

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# --- Logging ---
LOG_LEVEL=INFO

# --- AI (M29: AI Chemistry Tutor) ---
# AI is opt-in. "mock" (default) uses the in-process MockAIProvider so the
# system is fully testable without any external LLM or API key.
# Set to "openai" for an OpenAI-compatible HTTP API or "anthropic" for the
# Anthropic Messages API. Keys are read server-side only.
AI_PROVIDER=mock
# AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_ANTHROPIC_BASE=https://api.anthropic.com
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_TIMEOUT_SECONDS=30
# AI_MAX_INPUT_TOKENS=4000
# AI_MAX_OUTPUT_TOKENS=512
# AI_MAX_TOOL_ITERATIONS=5
# AI_RATE_LIMIT_PER_MINUTE=20
